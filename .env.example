# Gemini API Settings (Backend only - NEVER prefix with VITE_)
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Models:
# - gemini-3.5-flash (recommended fast & stable default)
# - gemini-3.5-flash-lite
# - gemini-3.8-flash
# - gemini-3.7-flash
# - gemini-3.6-flash
# - gemini-3.1-flash-lite
# - gemini-4-argon
# Comma-separated Gemini models in priority order (GEMINI_MODEL still works as a single-model list)
GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MIN_GAP_MS=4000
BATCH_SIZE=4
POOL_MIN_PER_TOPIC=4
POOL_TARGET_PER_TOPIC=10

# Backend Server Port
PORT=3000

# MySQL Database Settings (Backend only - NEVER prefix with VITE_)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cmathgames
