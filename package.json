{
  "name": "matrices-snl",
  "version": "1.0.0",
  "description": "Web-based Snake and Ladders game with AI-generated Computing Mathematics (Matrices) questions",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev -- npx vite",
    "build": "vite build",
    "deploy": "wrangler pages deploy dist",
    "db:local": "wrangler d1 execute matrices-snl-db --local --file=db/schema.sql",
    "db:remote": "wrangler d1 execute matrices-snl-db --remote --file=db/schema.sql",
    "seed-pool": "node scripts/seedPool.js",
    "migrate-mysql-to-d1": "node scripts/migrateMysqlToD1.js",
    "test": "node --test test/**/*.test.js"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "dotenv": "^18.0.10",
    "mysql2": "^3.24.6",
    "terser": "^5.51.2",
    "vite": "^8.3.8",
    "wrangler": "^4.14.0"
  }
}
