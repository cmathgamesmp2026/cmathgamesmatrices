{
  "name": "matrices-snl",
  "version": "1.0.0",
  "description": "Web-based Snake and Ladders game with AI-generated Computing Mathematics (Matrices) questions",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"server,vite\" -c \"blue,green\" \"node server/server.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/server.js",
    "init-db": "node server/scripts/initDb.js",
    "test": "node --test test/**/*.test.js"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "terser": "^5.51.2",
    "vite": "^8.3.8"
  }
}
